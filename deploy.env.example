# 复制为 .env（与 docker-compose.yml 同级），按需修改；不要提交真实密钥。
# docker compose 会自动读取当前目录 .env 做变量替换。

# ---- 端口 / 时区 / 数据库 ----
APP_PORT=8000
TZ=Asia/Shanghai
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=procurement

# ---- 模型网关（默认离线，演示零成本）----
FORCE_FAKE_LLM=1
DEEPSEEK_BASE_URL=https://opencode.ai/inference/go/openai/v1
DEEPSEEK_API_KEY=
REASON_MODEL=deepseek-v4.1-flash
ZHIPU_BASE_URL=https://opencode.ai/inference/go/openai/v1
ZHIPU_API_KEY=
REASON_SMALL_MODEL=glm-5.3-flash

# ---- 演示 ----
DEMO_STEP_DELAY_MS=350


# M2 账期资金占用折算（0=关闭；基准账期默认 30 天）
M2_FINANCING_ANNUAL_RATE=0.08
M2_FINANCING_BASELINE_DAYS=30
