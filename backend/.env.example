# ===== 运行环境 =====
APP_ENV=dev
# PostgreSQL 16 + pgvector（docker compose 起的库）
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/procurement
DB_CONNECT_TIMEOUT_S=1.5
FX_USD_CNY=7.1

# ===== SSE 事件总线 =====
SSE_POLL_INTERVAL_MS=250
SSE_HEARTBEAT_S=15
# 演示用假 run 每步延迟（毫秒），便于肉眼观察节点进度
DEMO_STEP_DELAY_MS=350

# ===== 模型网关（默认离线 FakeLLM；接真实模型时置 0 并填 key）=====
FORCE_FAKE_LLM=1
LLM_CONFIG_PATH=app/llm/models.yaml
PROMPT_CACHE_DIR=.cache/prompts

# ===== 按角色分工的模型（真实调用时填写；详见 docs/PROJECT_SPEC.md §2.5/§4.2）=====
DEEPSEEK_BASE_URL=https://opencode.ai/inference/go/openai/v1
DEEPSEEK_API_KEY=
REASON_MODEL=deepseek-v4.1-flash
REASON_SMALL_MODEL=glm-5.3-flash

# 视觉（VLM）：填任意 OpenAI 兼容视觉端点即可；OpenCode Go 网关的 Qwen 只走 Anthropic，不适用
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 用供应商控制台的真实视觉模型 ID（如 qwen-vl-max / qwen-vl-plus / qwen/qwen2.5-vl-72b-instruct）
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max
VISION_CHEAP_MODEL=qwen-vl-plus
# embedding：role 已预留，但 dense 检索 leg/回填尚未实现（只填配置不会启用）
EMBED_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank

ZHIPU_BASE_URL=https://opencode.ai/inference/go/openai/v1
ZHIPU_API_KEY=
# VISION_BACKUP_MODEL 当前未使用（vision role 的 fallback 在 models.yaml 配置）

# ===== 演示限额（P0 未启用限流，W4 打开）=====
DEMO_RATE_LIMIT_RUNS=10
