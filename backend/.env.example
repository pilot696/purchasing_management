# ===== 运行环境 =====
APP_ENV=dev
# PostgreSQL 16 + pgvector（docker compose 起的库）
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/procurement
DB_CONNECT_TIMEOUT_S=1.5
FX_USD_CNY=7.1

# ===== SSE 事件总线 =====
SSE_POLL_INTERVAL_MS=250
SSE_HEARTBEAT_S=15
# 演示用假 run 每步延迟（毫秒），便于肉眼观察节点进度
DEMO_STEP_DELAY_MS=350

# ===== 模型网关（P0 只跑 FakeLLM；置 1 后强制离线）=====
FORCE_FAKE_LLM=1
LLM_CONFIG_PATH=app/llm/models.yaml
PROMPT_CACHE_DIR=.cache/prompts

# ===== 按角色分工的模型（真实调用时填写；详见 docs/PROJECT_SPEC.md §2.5/§4.2）=====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
REASON_MODEL=deepseek-flash
REASON_SMALL_MODEL=glm-5.3-flash

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
VISION_MODEL=qwen3.8-max
VISION_CHEAP_MODEL=qwen3.8-flash
EMBED_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank

ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
VISION_BACKUP_MODEL=glm-5.3-flash

# ===== 演示限额（P0 未启用限流，W4 打开）=====
DEMO_RATE_LIMIT_RUNS=10
